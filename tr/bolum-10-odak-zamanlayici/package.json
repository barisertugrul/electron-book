{
  "name": "odak-zamanlayici",
  "productName": "Odak Zamanlayıcı",
  "version": "1.0.0",
  "description": "Sistem tepsisinde çalışan Pomodoro zamanlayıcısı (Bölüm 10)",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "test": "node --test",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "author": "ERT Yazılım",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "45.5.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "icon": "assets/icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip"
        }
      ]
    }
  }
}
