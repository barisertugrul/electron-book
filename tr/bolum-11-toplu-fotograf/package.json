{
  "name": "toplu-fotograf",
  "productName": "Toplu Fotoğraf",
  "version": "1.0.0",
  "description": "Fotoğrafları tarihe göre yeniden adlandıran, küçülten ve klasörlere ayıran araç (Bölüm 11)",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "test": "node --test",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "author": "ERT Yazılım",
  "license": "MIT",
  "dependencies": {
    "exifr": "^7.1.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "45.5.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": {
          "unpack": "**/node_modules/{sharp,@img}/**/*"
        },
        "icon": "assets/icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip"
        }
      ]
    }
  }
}
